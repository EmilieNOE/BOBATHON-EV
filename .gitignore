# secrets and skore-cli credentials
.env
.skore

# virtual environment created in the install steps
.venv/

# skills are installed per machine — do not vendor them
.bob/*
# ...but the workspace rules do ship with the repo
!.bob/rules/

# per-machine agent symlinks pointing into .bob/skills
.pi/
.agents/

# agent scratch probes
scratch/

# Kaggle submission files (regenerated by the experiment scripts;
# the leaderboard, not git, is the record)
submissions/

# bytecode
__pycache__/
*.pyc

# nested clone of https://github.com/probabl-ai/skills-hackathon
skills/

# OS / IDE
.DS_Store

# local git worktrees
.worktrees/
# Windows virtual environment
.venv-win/

# Local credentials and environment files
.env.*
!.env.example

# Local datasets and EDA reports
data/*.csv
data/*.parquet
data/*.xlsx
data/*.json
data/*.html

# Python cache and build artifacts
__pycache__/
*.py[cod]
*.egg-info/

# Local Skore reports and generated outputs
evdgreenteam/
submissions/
scratch/